# Server-side secret. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key

# Agent worker controls.
WORKER_MODEL=sonnet
WORKER_MAX_USD=2
WORKER_RECOVER_RUNNING=1

# Public host port used by Docker Compose.
FRAME_FORGE_PORT=3000

# Optional: override the pinned img2threejs Git commit used by the worker image.
IMG2THREEJS_GIT_REF=e8ff28a6ae0cb534c7b2ebc15cb3f06709262d5b
